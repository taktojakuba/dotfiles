* {
  bg: #16161e;
  bg-alt: #2f334d;
  fg: #c0caf5;
  accent: #7aa2f7;
  accent-fg: #16161e;
  border: #3b4261;
}

window {
  background-color: @bg;
  text-color: @fg;
  border: 1px;
  border-color: @border;
  border-radius: 0px;
  padding: 0px;
}

mainbox {
  background-color: transparent;
  spacing: 5px;
}

inputbar {
  background-color: @bg-alt;
  text-color: @fg;
  border-radius: 0px;
  padding: 0px 0px;
  spacing: 5px;
}

prompt, entry {
  background-color: transparent;
  text-color: @fg;
}

listview {
  background-color: transparent;
  spacing: 0px;
  lines: 5;
}

element {
  background-color: transparent;
  text-color: @fg;
  border-radius: 0px;
  padding: 0px 0px;
}

element selected {
  background-color: @accent;
  text-color: @accent-fg;
}

element-text, element-icon {
  background-color: transparent;
  text-color: inherit;
}

message {
  background-color: @bg-alt;
  text-color: @fg;
  border-radius: 0px;
  padding: 0px;
}