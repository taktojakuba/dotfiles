font=mono 12
border-size=1
border-radius=0

width=360
padding=5
margin=20
anchor=top-right

icons=0

default-timeout=10000
ignore-timeout=0
max-visible=5
sort=-time
layer=overlay

format=<b>%s</b>\n%b
markup=1
group-by=app-name

background-color=#181818
text-color=#ececec
border-color=#444444

[mode=do-not-disturb]
invisible=1
on-notify=none

[mode=silent]
on-notify=none

[urgency=high]
border-color=#d9d9d9
