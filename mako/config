font=mono 12
background-color=#1a1b26
text-color=#c0caf5
border-color=#586691
border-size=1
border-radius=0

width=360
padding=5
margin=20
anchor=top-right

icons=0

default-timeout=10000
ignore-timeout=0
max-visible=5
sort=-time
layer=overlay

format=<b>%s</b>\n%b
markup=1
group-by=app-name

[urgency=low]
background-color=#1a1b26
text-color=#c0caf5
border-color=#586691

[urgency=normal]
background-color=#1a1b26
text-color=#c0caf5
border-color=#586691

[urgency=high]
default-timeout=0
background-color=#1a1b26
text-color=#16161e
border-color=#f7768e
